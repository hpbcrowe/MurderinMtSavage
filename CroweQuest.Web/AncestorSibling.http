@baseUrl = http://localhost:5000
@token = replace-with-a-valid-token

### Remove a sibling relationship in both directions
DELETE {{baseUrl}}/api/AncestorProfile/1/siblings/2
Authorization: Bearer {{token}}

### Invalid: an ancestor cannot be their own sibling
DELETE {{baseUrl}}/api/AncestorProfile/1/siblings/1
Authorization: Bearer {{token}}
